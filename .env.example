# Cloud provider credentials are read server-side by IND and never written to memory.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Local or OpenAI-compatible endpoint, for example Ollama.
IND_PROVIDER=openai-compatible
IND_BASE_URL=http://localhost:11434/v1
IND_MODEL=

# Optional project configuration override.
IND_CONFIG=




# Optional encrypted memory sync; sync is opt-in and requires both values.
IND_SYNC_URL=
IND_SYNC_KEY=

